# ClickHouse（唯讀查詢）
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ocard

# MySQL（唯讀，只讀 brand 表做「品牌名稱（品牌編號）」對照）
# 未設定時品牌一律只顯示編號，不影響監測本身
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=ocard

# Fingerprint 遮罩用 HMAC 密鑰（64 hex，外洩須輪替並使所有歷史 fingerprint 失效）
FP_SECRET=

# Slack Incoming Webhook（告警用；留空則只記 log 不送出）
SLACK_WEBHOOK_URL=

# Ocard ROS（統一登入入口）的網址。
# 留空 = 停用登入驗證，任何人都能直接進入 —— 只可用於離線 demo。
# 本機開發：http://localhost:3000　正式：https://ros.ocard.co
ROS_BASE_URL=

# 本主控台的對外網址。同時決定兩件事，所以只需設這一個值：
#   1. Slack 告警裡連回事件詳細頁的連結前綴
#   2. 未登入導向 ROS 登入頁時，登入完要回到哪（callbackUrl）
# 本機開發：http://127.0.0.1:8600　掛在 ROS 底下：https://ros.ocard.co/security
CONSOLE_BASE_URL=
