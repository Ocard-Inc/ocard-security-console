# ClickHouse（唯讀查詢）
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ocard

# MySQL（唯讀，只讀 brand 表做「品牌名稱（品牌編號）」對照）
# 未設定時品牌一律只顯示編號，不影響監測本身
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=ocard

# Fingerprint 遮罩用 HMAC 密鑰（64 hex，外洩須輪替並使所有歷史 fingerprint 失效）
FP_SECRET=

# Slack Incoming Webhook（告警用；留空則只記 log 不送出）
SLACK_WEBHOOK_URL=

# Slack 通知的總開關。開啟值只認 1 / true / yes / on —— 打錯（ture）視為關閉。
#
# **留空 = 由 CONSOLE_BASE_URL 推導**：指向 localhost（開發機）→ 不發；
# 指向對外網址（正式部署）→ 發。明確設定一律優先。
#
# 為什麼需要它：開發機的 .env 帶的是正式頻道的 webhook，而本機會跑 pytest、
# replay 與手動驗收。那些訊息送進值班頻道只會把人訓練成忽略它，而 Allowlist
# 的 ops 訊息是唯一一個當事人改不掉的偵測型控制。
#
# 為什麼預設值是推導而不是固定關閉：固定關閉的話，Secret Manager 裡那份
# prod.env 漏一行就讓正式環境靜靜不發任何告警，而畫面完全正常。推導的方向
# 相反 —— 正式環境什麼都不用設就是開的，要關才需要動手。
SLACK_ENABLED=

# Ocard ROS（統一登入入口）的網址。
# 留空 = 停用登入驗證，任何人都能直接進入 —— 只可用於離線 demo。
# 本機開發：http://localhost:3000　正式：https://ros.ocard.co
ROS_BASE_URL=

# 本主控台的對外網址。同時決定兩件事，所以只需設這一個值：
#   1. Slack 告警裡連回事件詳細頁的連結前綴
#   2. 未登入導向 ROS 登入頁時，登入完要回到哪（callbackUrl）
# 本機開發：http://127.0.0.1:8600　掛在 ROS 底下：https://ros.ocard.co/security
CONSOLE_BASE_URL=
