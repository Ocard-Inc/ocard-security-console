# ClickHouse（唯讀查詢）
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ocard

# MySQL（唯讀，只讀 brand 表做「品牌名稱（品牌編號）」對照）
# 未設定時品牌一律只顯示編號，不影響監測本身
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=ocard

# Fingerprint 遮罩用 HMAC 密鑰（64 hex，外洩須輪替並使所有歷史 fingerprint 失效）
FP_SECRET=

# Slack Incoming Webhook（Phase 3 告警用）
SLACK_WEBHOOK_URL=
